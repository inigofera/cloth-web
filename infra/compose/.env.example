# inibaby production environment (plan §2.2). Copy to .env in this directory
# and fill in. The real .env is gitignored — never commit it.
#
# This is the same variable set the old server's .env had, plus
# CORS_ALLOWED_ORIGINS.

# --- Required ---------------------------------------------------------------

# Supabase Postgres direct connection string (db.<ref>.supabase.co, port 5432).
DATABASE_URL=

# Supabase project URL — also the JWT `iss` every valid access token carries.
SUPABASE_URL=

# Project Settings → API → JWT Secret. Never in the frontend bundle.
SUPABASE_JWT_SECRET=

# service_role key: the backend's Storage API access, and what backup.sh uses.
SUPABASE_SERVICE_ROLE_KEY=

SUPABASE_STORAGE_BUCKET=clothing-wardrobe

# 32-byte hex: `openssl rand -hex 32`. Encrypts per-user settings (Gemini key).
# REUSE the old server's value if users have stored settings — a new key would
# make their encrypted keys unreadable and force re-entry.
SETTINGS_ENCRYPTION_KEY=

# --- CORS (required for the Pages deployment) -------------------------------
# Comma-separated EXACT origins the browser may read the API from — never `*`
# (the API carries Authorization headers).
CORS_ALLOWED_ORIGINS=https://cloth.inigoartolozaga.com

# --- Optional: Discord integration ------------------------------------------
# All-or-nothing: if DISCORD_BOT_TOKEN is set, DISCORD_DEFAULT_USER_ID must be
# too (the startup sweep imports for exactly one user and refuses to guess).
# At cutover: rotate the bot token (Discord Developer Portal → Reset Token)
# and remove the old server's copy so it isn't live in two places.
DISCORD_BOT_TOKEN=
DISCORD_DEFAULT_USER_ID=
DISCORD_CHANNEL_ID=
DISCORD_CREATOR_ID=

# --- Optional: tuning --------------------------------------------------------
RUST_LOG=info
# Local Qwen try-on (only if the inference worker is deployed on inibaby):
# ALLOW_LAN_INFERENCE_URLS=true
# GEMINI_API_BASE=
